{
    "dataset": {
        "extension": "xdmf",
        "train_path": "/scratch-big/vlannelongue1/00_Data/Datasets/NoStentCoarse/train",
        "test_path": "/scratch-big/vlannelongue1/00_Data/Datasets/NoStentCoarse/test",
        "meta_path": "dataset_config/aneurysm_meta_wss.json",
        "targets": ["Vitesse", "WSS"],
        "training_nodetypes":["normal", "outflow", "wall_boundary", "aneurysm"],
        "khop": 1,
        "new_edges_ratio": 0
    },
    "model": {
        "type": "transformer",
        "message_passing_num": 15,
        "hidden_size": 256,
        "node_input_size": 25,
        "output_size": 6,
        "edge_input_size": 0,
        "num_heads": 4,
        "use_silu_activation": false,
        "use_rope_embeddings": false,
        "use_gated_attention": false
    },
    "loss": {
        "type": ["l2loss", "l2losswss", "gradientl2loss", "cosinel2loss"],
        "gradient_method": "finite_diff",
        "weights": [0.5, 0.5, 30.0, 0.15],
        "loss_index_start": [0, 3, 0, 0],
        "loss_index_end": [3, 6, 3, 3],
        "use_learnable_weights": true
    },
    "index": {
        "feature_index_start": 0,
        "feature_index_end": 25,
        "output_index_start": 0,
        "output_index_end": 6,
        "node_type_index": 25
    },
    "transformations": {
        "preprocessing": {
            "noise": [10.0, 10.0, 10.0, 0.1, 0.1, 0.1, 10.0, 10.0, 10.0],
            "noise_index_start": [0, 1, 2, 3, 4, 5, 7, 8, 9],
            "noise_index_end": [1, 2, 3, 4, 5, 6, 8, 9, 10],
            "masking": 0
        },
        "world_pos_parameters": {
            "use": false,
            "world_pos_index_start": 0,
            "world_pos_index_end": 3
        }
    },
    "training": {
        "use_spatial_mtp": false,
        "use_temporal_block": false,
        "enable_vram_optimizations": false
    }
}
