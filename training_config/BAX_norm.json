{
    "dataset": {
        "extension": "xdmf",
        "train_path": "/scratch-big/vlannelongue1/00_Data/Datasets/BenchAnXplore/train",
        "test_path": "/scratch-big/vlannelongue1/00_Data/Datasets/BenchAnXplore/inference",
        "meta_path": "dataset_config/aneurysm_meta.json",
        "targets": ["Vitesse"],
        "khop": 1,
        "new_edges_ratio": 0
    },
    "model": {
        "type": "transformer",
        "message_passing_num": 10,
        "hidden_size": 64,
        "node_input_size": 13,
        "output_size": 3,
        "edge_input_size": 0,
        "num_heads": 4,
        "use_silu_activation": false,
        "use_rope_embeddings": false,
        "use_gated_attention": false
    },
    "loss": {
        "type": ["l2loss", "cosinel2loss"],
        "weights": [0.6, 0.15]
    },
    "index": {
        "feature_index_start": 0,
        "feature_index_end": 13,
        "output_index_start": 0,
        "output_index_end": 3,
        "node_type_index": 13
    },
    "transformations": {
        "preprocessing": {
            "noise": [10.0, 10.0, 1.0, 10.0, 10.0, 1.0],
            "noise_index_start": [0, 1, 2, 4, 5, 6],
            "noise_index_end": [1, 2, 3, 5, 6, 7],
            "masking": 0
        },
        "world_pos_parameters": {
            "use": false,
            "world_pos_index_start": 0,
            "world_pos_index_end": 3
        }
    },
    "training": {
        "use_spatial_mtp": false,
        "use_temporal_block": false,
        "enable_vram_optimizations": false
    }
}
